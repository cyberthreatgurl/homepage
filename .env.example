# =============================================================================
# Homepage Environment Variables Example (.env.example)
# =============================================================================
# Copy this file to `.env` and populate it with your own credentials:
#   cp .env.example .env
#
# In Homepage, any environment variable starting with `HOMEPAGE_VAR_` can be
# referenced in YAML config files using `{{HOMEPAGE_VAR_NAME}}`.
# Make sure your Homepage container loads `.env` (e.g., `env_file:` in Docker Compose).
# =============================================================================

# --- Active Service Widgets (services.yaml) ---
# TinyGS station identifier (e.g., CALLSIGN_Node_1@1234567890)
HOMEPAGE_VAR_TINYGS_STATION="YOUR_CALLSIGN_Node@0000000000"

# Paperless-ngx API token (Settings -> Users -> Auth Token)
HOMEPAGE_VAR_PAPERLESS_KEY="your_paperless_api_token_here"

# Pi-hole v6 Plain-Text App Password (or Web Admin Password)
# NOTE: Must be the plain-text password (NOT the $BALLOON-SHA256$ hash from pihole.toml).
# Homepage uses this value to POST {"password": "..."} to /api/auth and obtain a session SID.
HOMEPAGE_VAR_PIHOLE_KEY="your_plain_text_pihole_v6_app_password"

# MikroTik RouterOS API credentials
HOMEPAGE_VAR_MIKROTIK_USER="admin"
HOMEPAGE_VAR_MIKROTIK_PASS="your_mikrotik_password_here"

# --- Optional / Commented Service Widgets (services.yaml) ---
# Uncomment the corresponding widget blocks in services.yaml to use these:
HOMEPAGE_VAR_PROXMOX_USER="api@pam!homepage"
HOMEPAGE_VAR_PROXMOX_TOKEN="your_proxmox_api_token_secret"
HOMEPAGE_VAR_PORTAINER_KEY="your_portainer_access_token"
HOMEPAGE_VAR_NETBOX_KEY="your_netbox_api_token"
HOMEPAGE_VAR_LIBRENMS_KEY="your_librenms_api_token"
HOMEPAGE_VAR_WAZUH_USER="wazuh_api_user"
HOMEPAGE_VAR_WAZUH_PASS="your_wazuh_api_password"
HOMEPAGE_VAR_HASS_TOKEN="your_home_assistant_long_lived_access_token"
HOMEPAGE_VAR_JELLYFIN_KEY="your_jellyfin_api_key"
HOMEPAGE_VAR_JELLYSTAT_KEY="your_jellystat_api_key"

# --- Proxmox VE Integration (proxmox.yaml) ---
HOMEPAGE_VAR_PROXMOX_TOKEN_ID="root@pam!your_token_id"
HOMEPAGE_VAR_PROXMOX_SECRET="your_proxmox_token_secret"

# --- Global Providers (settings.yaml) ---
HOMEPAGE_VAR_OPENWEATHERMAP_KEY="your_openweathermap_api_key"
HOMEPAGE_VAR_WEATHERAPI_KEY="your_weatherapi_key"

# --- Weather & Location Info Widget (widgets.yaml) ---
HOMEPAGE_VAR_WEATHER_LABEL="City, ST"
HOMEPAGE_VAR_WEATHER_LAT="38.8977"
HOMEPAGE_VAR_WEATHER_LON="-77.0365"
HOMEPAGE_VAR_WEATHER_TZ="America/New_York"
